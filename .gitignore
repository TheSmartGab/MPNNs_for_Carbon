# =============================================================================
# Generated data, metrics & plots (bulk — not for git)
#   NOTE: *.in / *.conf / *.xyz are LAMMPS/DFT *input* scripts & structures and
#         are intentionally KEPT (they are the reproducible computational setup).
# =============================================================================
*.npy
*.npz
*.json
*.csv
*.done
*.log
*.err
*.out
*.pdf
*.svg
*.png
*.gif

# =============================================================================
# Generated working / logging / output dirs (scratch — not for git)
# =============================================================================
WORKING/
logger/
outputs/

# =============================================================================
# nequip per-run version directories (generated training runs).
#   Each holds only duplicated scripts + a per-run config + checkpoints — no
#   unique source. Scoped to nequip/ so real experiment-root files (e.g.
#   GRAPHENE_MLIP/all_100frames/run_evaluations.sh) are preserved.
# =============================================================================
nequip/**/v[0-9]*/
nequip/**/checkpoint_v[0-9]*/
nequip/**/model_*/
nequip/**/T[0-9]_b*/
nequip/**/lr_*/
nequip/**/1000_all_lr_*/
nequip/rmax6/*/

