# =============================================================================
# Python build & bytecode
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.so

# =============================================================================
# Virtual environments & package caches (regenerated on every machine)
# =============================================================================
.venv/
uv_tmp/

# =============================================================================
# Simulation data & model artifacts (bulk — not for git)
# =============================================================================
*.traj
*.lammpstrj
*.dump
*.lammps
*.restart
RESTARTS_*
*.lammps-data
*.model
*.pt
*.pth
*.ckpt
*.extxyz
*.swp
# =============================================================================
# KEPT: final model weights — intentionally tracked, overriding the *.model /
#       *.pt / *.pth / *.ckpt ignores above. Only exported finals: no per-epoch
#       checkpoints, no pretrained / foundation models.
# =============================================================================
# Dataset-size study: every final MACE model across all training sizes
#   (8 sizes x {base, _compiled, _stagetwo, _stagetwo_compiled} + the 2 exported
#    checkpoints each). No per-epoch .model files exist under NEW_SPLIT.
!DATASET_SIZE_STUDY/NEW_SPLIT/mace/from_C2_v1/*/MACE_*.model
!DATASET_SIZE_STUDY/NEW_SPLIT/mace/from_C2_v1/*/checkpoints/MACE_*.model

