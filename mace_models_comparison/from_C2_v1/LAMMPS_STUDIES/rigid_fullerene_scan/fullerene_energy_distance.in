# ============================================================
# Relax single fullerene
# ============================================================

units           metal
dimension       3
boundary        s s s
atom_style      atomic
newton          on
atom_modify     map yes

read_data       fullerene.lammps-data

mass            1 12.011
labelmap        atom 1 C

pair_style      mace no_domain_decomposition
pair_coeff      * * "../../MACE.model-lammps.pt" C

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.001

thermo          10
thermo_style    custom step pe fmax

dump            relax_dump all atom 10 fullerene_relax.dump

reset_timestep  0
minimize        0 1e-8 1000 10000

write_data      relaxed_fullerene.lammps-data

undump          relax_dump
print           "Single fullerene relaxation done"

# ============================================================
# Fullerene–fullerene interaction scan
# ============================================================

clear
units           metal
dimension       3
boundary        s s s
atom_style      atomic
atom_modify     map yes
newton          on

read_data       relaxed_fullerene.lammps-data
read_data       relaxed_fullerene.lammps-data add append offset 0 0 0

mass            1 12.011
labelmap        atom 1 C

pair_style      mace no_domain_decomposition
pair_coeff      * * "../../MACE.model-lammps.pt" C

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Define molecules
group           mol1 id <= ${natoms}/2
group           mol2 subtract all mol1

variable        zmin equal 8.0
variable        zmax equal 25.0
variable        dz   equal 0.5
variable        nsteps equal floor((${zmax}-${zmin})/${dz})+1

variable        outfile string fullerene_potential.out
print           "# distance(A)   PE(eV)" file ${outfile}

thermo          1
thermo_style    custom step pe

variable i loop ${nsteps}
label loop_start

    variable zsep equal ${zmin} + (${i}-1)*${dz}

    displace_atoms mol2 move 0.0 0.0 ${zsep} units box

    reset_timestep 0
    minimize 0 1e-8 200 2000

    variable pe equal pe
    print "${zsep} ${pe}" append ${outfile}

    displace_atoms mol2 move 0.0 0.0 -${zsep} units box

next i
jump SELF loop_start

print "Distance scan complete"
