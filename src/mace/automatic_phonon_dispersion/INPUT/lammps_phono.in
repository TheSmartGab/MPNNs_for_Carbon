variable INPUT_DATA index "input.xyz"
variable OUTPUT_DATA index "force.*"
variable MODEL_FILE index "model.pth"

# ---------------- INITIALIZATION ----------------

units           metal
dimension       3
boundary        p p p
atom_style      atomic
newton          on
atom_modify     map yes

read_data       ${INPUT_CONFIG}

mass            1 12.011

pair_style      mliap unified ${MODEL} 0
pair_coeff      * * C

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ----------------------------------------------------

read_data ${INPUT_DATA}

dump phonopy all custom 1 ${OUTPUT_DATA} id type x y z fx fy fz
dump_modify phonopy format line "%d %d %15.8f %15.8f %15.8f %15.8f %15.8f %15.8f"
run 0