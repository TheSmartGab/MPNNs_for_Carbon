# ============================================================
# NVE + Langevin
# ============================================================
# This script allows you to run thermalization steps at the current strain, deform the structure to the new strain, and thermalize at the new strain
# it was taken from the restart_strain_stress type of scripts, and adapted by changing the restart logic

# additional information to tell the script the current strain
variable current_exx index 0.0
variable current_eyy index 0.0
variable current_ezz index 0.0
variable current_gyz index 0.0
variable current_gxz index 0.0
variable current_gxy index 0.0

# ---------------- DEFAULT STRAIN COMPONENTS ----------------
# (All zero unless overridden from command line)

variable target_exx index 0.0
variable target_eyy index 0.0
variable target_ezz index 0.0
variable target_gyz index 0.0
variable target_gxz index 0.0
variable target_gxy index 0.0

# ---------------- OTHER USER VARIABLES ----------------

variable MODEL          index ../../MACE.model-mliap_lammps.pt
variable INPUT_CONFIG   index input.lammps-data 


variable TEMP           index 300.0
variable SEED           index 1009 # can make simulations independent by changing this. 

variable timestep       index 0.001
variable tdamp          index 1.0 
variable stepscurrent   index 3000
variable stepsnext      index 10000

# DUMP
variable DUMPFILE index change_strain.dump
variable OUTFILE index "/dev/null"

# ---------------- INITIALIZATION ----------------

units           metal
dimension       3
boundary        p p p
atom_style      atomic
newton          on
atom_modify     map yes

read_data       ${INPUT_CONFIG}

mass            1 12.011

pair_style      mliap unified ${MODEL} 0
pair_coeff      * * C

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        ${timestep}

# ---------------- INITIAL GEOMETRY --------------

print "INITIALIZING GEOMETRY VARIABLES"

# Convert to triclinic so shear components are allowed
print "CHANGE BOX TRICLINIC"
change_box all triclinic
run 0

#Define tracking variables (dynamic)
variable lx equal lx
variable ly equal ly
variable lz equal lz

variable xy equal xy
variable xz equal xz
variable yz equal yz

#Freeze the initial box as constants AFTER defining dynamic variables
variable l0x equal ${lx} / (1+${current_exx})
variable l0y equal ${ly} / (1+${current_eyy})
variable l0z equal ${lz} / (1+${current_ezz})

variable xy0 equal ${xy} / (1+${current_gxy})
variable xz0 equal ${xz} / (1+${current_gxz})
variable yz0 equal ${yz} / (1+${current_gyz})


# ---------------- COMPUTES ----------------

print "DEFINING COMPUTES"
compute temp_compute  all temp
compute press_compute all pressure temp_compute

# ---------------- DUMP ----------------

print "DEFINING DUMP"
dump mydump all custom 1 ${DUMPFILE} id type x y z vx vy vz fx fy fz 

# ---------------- INTEGRATION ----------------

print "DEFINING TIME INTEGRATION AND THERMOSTAT"
fix integrator all nve

fix thermostat all langevin ${TEMP} ${TEMP} ${tdamp} ${SEED} zero yes

# ---------------- Increase Strain ----------------

# first finish steps
print "RUNNING STEPS AT CURRENT STRAIN"
# Increment fraction
# copied syntax from the loop to ensure same logic is applied

# Current strain
variable exx equal ${current_exx}
variable eyy equal ${current_eyy}
variable ezz equal ${current_ezz}

# Target shear strains 
variable gyz equal ${current_gyz}
variable gxz equal ${current_gxz}
variable gxy equal ${current_gxy}

# ---------------- THERMO ----------------

print "DEFINING THERMO"
thermo 1

thermo_style custom step temp &
lx ly lz xy xz yz &
v_exx v_eyy v_ezz v_gxy v_gxz v_gyz &
c_press_compute[1] c_press_compute[2] c_press_compute[3] &
c_press_compute[4] c_press_compute[5] c_press_compute[6] &
ke pe

run ${stepscurrent}

print "INCREASE STRAIN"

# Target strain
variable exx equal ${target_exx}
variable eyy equal ${target_eyy}
variable ezz equal ${target_ezz}

# Target shear strains 
variable gyz equal ${target_gyz}
variable gxz equal ${target_gxz}
variable gxy equal ${target_gxy}

# Updated box lengths (relative to INITIAL box)
variable new_lx equal ${l0x}*(1.0 + ${exx})
variable new_ly equal ${l0y}*(1.0 + ${eyy})
variable new_lz equal ${l0z}*(1.0 + ${ezz})

# Updated tilt factors (include initial tilt)
variable new_xy equal ${xy0} + ${l0y}*${gxy}
variable new_xz equal ${xz0} + ${l0z}*${gxz}
variable new_yz equal ${yz0} + ${l0z}*${gyz}

# Apply full strain tensor relative to initial state
change_box all & 
    x final 0.0 ${new_lx} & 
    y final 0.0 ${new_ly} & 
    z final 0.0 ${new_lz} & 
    xy final ${new_xy} & 
    xz final ${new_xz} & 
    yz final ${new_yz} & 
    remap units box
run 0

# ---------------- THERMO ----------------

run ${stepsnext}

# usefull if the output mustbe used to restart
write_data ${OUTFILE}