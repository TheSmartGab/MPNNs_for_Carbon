# command line arguments, overridden when passed
variable OUTPUT_RELAXED index "relaxed.xyz"
variable INPUT_DATA index "input.xyz"
variable MODEL_FILE index "model.pth"

units	metal
atom_style atomic
dimension 3

# set newton on for pair_allegro (off for pair_nequip)
newton off
boundary p p p
read_data  ${INPUT_DATA}

# nequip pair style
pair_style	nequip
pair_coeff	* * ${MODEL_FILE} C

# dump ID ID-to-dump style nsteps file **args
dump dump_relax all atom 10 single_relax.xyz

variable etol equal 1e-12
variable ftol equal 1e-8
variable maxiter equal 1000
variable maxeval equal 100000

# relax also cell vectors
fix 1 all box/relax x 0.0 y 0.0 vmax 0.001 nreset 20 

# relax structure (positions + box)
minimize ${etol} ${ftol} ${maxiter} ${maxeval}

# clean up fix
unfix 1

write_data ${OUTPUT_RELAXED}
